WECHAT_PROVIDER=codex-import
WECHAT_WORKSPACE=.runtime/v1.1
# Optional compatible API mode: configure models.json, then set provider=compatible.
WECHAT_MODEL_CONFIG=.runtime/models.json
# Supply real keys only through the process environment; never commit them.
# WECHAT_MODEL_API_KEY=

# v1.3 defaults to editorial-only work; blocks approvals and all export bundles.
WECHAT_WORK_MODE=EDITORIAL_FIRST
