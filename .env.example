# Safe names/defaults only. This file is not loaded automatically.
# Set values in the process environment or the Windows DPAPI settings UI.
WECHAT_PROVIDER=codex-import
WECHAT_WORKSPACE=.runtime/v1.1
WECHAT_WORK_MODE=EDITORIAL_FIRST
# Optional compatible API configuration; no provider calls without explicit configuration.
WECHAT_MODEL_CONFIG=.runtime/models.json
WECHAT_MODEL_API_KEY=
WECHAT_OLLAMA_MODEL=
WECHAT_OLLAMA_URL=http://127.0.0.1:11434
# Optional Director data directory, never a tracked policy/authorization file.
RANCHOMEDIA_NETWORK_ROOT=
# Draft SDK environment variable names used by an explicitly authorized local policy.
WECHAT_LOCAL_CANARY_APPID=
WECHAT_LOCAL_CANARY_TOKEN=
# Generate a fresh local API credential; do not copy another operator's value.
LOCAL_API_TOKEN=
DATABASE_URL=sqlite+aiosqlite:///.runtime/core.db
MOCK_DATABASE_URL=sqlite+aiosqlite:///.runtime/mock.db
AUTO_APPROVE_ENABLED=false
