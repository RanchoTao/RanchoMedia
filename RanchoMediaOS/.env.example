# Phase 2: optional process environment examples; Settings does not load a .env file.
APP_ENV=development
LOCAL_API_TOKEN=replace-with-a-locally-generated-secret
DATABASE_URL=sqlite+aiosqlite:///.runtime/core.db
MOCK_DATABASE_URL=sqlite+aiosqlite:///.runtime/mock.db
LOG_LEVEL=INFO
MOCK_PLATFORM_SEED=7
AUTO_APPROVE_ENABLED=false
